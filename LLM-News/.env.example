# FUNDAS
PUBLISHER_LIST=us.TheNewYorker,us.FoxNews,uk.TheGuardian,tw.TaipeiTimes,my.MalayMail,ca.CBCNews
FUNDUS_MAX_ARTICLES=50
FUNDUS_START_DATE=
FUNDUS_END_DATE=

# REDDIT
REDDIT_ID=
REDDIT_KEY=
SUBREDDIT_LIST=news,technology,science,worldnews,entertainment
REDDIT_MAX_POST=20
REDDIT_MAX_COMMENT=10

# TRUST SCORE
RAPID_API_KEY=

# OTHER
GOOGLE_API_KEY=
ELEVENLAB_API_KEY=

# LLM
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ALIBABA_LLM_KEY=
ALIBABA_LLM_KEY_KG=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Free key from build.nvidia.com (starts with nvapi-). NVIDIA allows it for development and testing only.
NVIDIA_API_KEY=
# Preferred provider for the news pipeline and the website (OPENROUTER, OPENAI, ALIBABA, GEMINI, PERPLEXITY, NVIDIA).
# The pipeline defaults to ALIBABA; the website uses the first provider with a key.
LLM_PUBLISHER=
# Pipeline model override (default: that provider's model below)
LLM_MODEL=
# Fact-check / coverage-comparison model (default: LLM_MODEL). A different model checks more strictly.
CHECK_MODEL=
# Per-provider model overrides (defaults in apps/app/core/providers.py), e.g. a free OpenRouter model:
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# GEMINI_MODEL=gemini-2.5-flash
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b   (with CHECK_MODEL=openai/gpt-oss-20b)
# Knowledge Graph chat (Alibaba DashScope application)
ALIBABA_KG_APP_ID=

# WEBSITE
# PostgreSQL stores reports, corrections, analytics, budgets and updater coordination in Docker.
# Generate a URL-safe random production password; never keep the development fallback publicly.
POSTGRES_DB=newssense
POSTGRES_USER=newssense
POSTGRES_PASSWORD=
# Optional live edition/media storage. Works with AWS S3 and Cloudflare R2. When configured,
# updater runs fail if remote persistence fails and new servers restore before becoming ready.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=news
OBJECT_STORAGE_REGION=auto
# R2: https://ACCOUNT_ID.r2.cloudflarestorage.com (leave empty for AWS S3)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Separate from the S3/R2 credential; signs manifests so storage tampering is detected.
OBJECT_STORAGE_MANIFEST_KEY=
# AI requests per visitor per minute; chat questions per visitor per day (so one visitor can't use up
# everyone's allowance); AI calls per day across everyone. 0 = no cap
AI_RATE_LIMIT=20
AI_VISITOR_DAILY_LIMIT=50
AI_DAILY_CALL_LIMIT=500
# Currency guardrails cover pipeline and website AI calls. Configure prices for each enabled provider.
AI_DAILY_SPEND_LIMIT_USD=10
AI_MONTHLY_SPEND_LIMIT_USD=100
AI_RESERVE_INPUT_TOKENS=10000
AI_RESERVE_OUTPUT_TOKENS=3000
# Example: OPENAI_INPUT_USD_PER_MTOK=0.15 and OPENAI_OUTPUT_USD_PER_MTOK=0.60
OPENROUTER_INPUT_USD_PER_MTOK=
OPENROUTER_OUTPUT_USD_PER_MTOK=
OPENAI_INPUT_USD_PER_MTOK=
OPENAI_OUTPUT_USD_PER_MTOK=
ALIBABA_INPUT_USD_PER_MTOK=
ALIBABA_OUTPUT_USD_PER_MTOK=
GEMINI_INPUT_USD_PER_MTOK=
GEMINI_OUTPUT_USD_PER_MTOK=
PERPLEXITY_INPUT_USD_PER_MTOK=
PERPLEXITY_OUTPUT_USD_PER_MTOK=
NVIDIA_INPUT_USD_PER_MTOK=
NVIDIA_OUTPUT_USD_PER_MTOK=
# Persistent daily allowance for news generation; also adjustable in /admin. 0 disables the cap.
# Counts attempted calls, including failures; the updater and backend share apps/cache in Docker.
PIPELINE_DAILY_CALL_LIMIT=200
# A second hard stop across the calendar month. 0 disables the cap.
PIPELINE_MONTHLY_CALL_LIMIT=4000
# Shown on the About and Privacy pages for corrections and privacy questions
CONTACT_EMAIL=
# Public business/contact address shown in legal records when configured.
CONTACT_ADDRESS=
# Public address used in share previews, RSS and emails, e.g. https://news.example.com
PUBLIC_BASE_URL=
# Your domain, for HTTPS with apps/docker-compose.prod.yml (it sets PUBLIC_BASE_URL=https://DOMAIN)
DOMAIN=
# News updates in Docker (the "updater" service): minutes between updates, and the time zone that
# decides when a new day's edition starts (default UTC)
UPDATE_MINUTES=60
# Hourly updates publish only fresh official AI-model source briefs, normally in seconds and without AI cost.
HOURLY_UPDATE_CATEGORIES=ai_models
HOURLY_UPDATE_PER_CATEGORY=1
HOURLY_UPDATE_PER_FEED=3
# The verifier upgrades pending briefs and adds fully checked multi-source coverage once each day.
FULL_UPDATE_AT=03:00
# Host directory containing generated editions and media. Deployment scripts default to separate
# /opt/newssense/data/production/static and /opt/newssense/data/staging/static directories.
# NEWS_DATA_DIR=/opt/newssense/data/production/static
# The readiness endpoint becomes unhealthy after this many minutes without a successful update.
# Keep it at least twice UPDATE_MINUTES to tolerate one delayed run.
STALE_AFTER_MINUTES=120
# A crashed updater's generation lease expires after this many seconds. This prevents overlapping AI spend.
UPDATE_LOCK_SECONDS=7200
# Durable worker polling interval. Failed jobs retry with exponential backoff.
JOB_POLL_SECONDS=5
# Optional HTTPS endpoint that receives queued release, price-change and story notifications.
NOTIFICATION_DELIVERY_WEBHOOK=
# Web Push VAPID keys. Generate once for each environment; VAPID_SUBJECT is mailto: or https:.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Comma-separated Web Push service host suffixes. Keep this narrow to prevent server-side request forgery.
PUSH_ENDPOINT_HOSTS=fcm.googleapis.com,push.services.mozilla.com,web.push.apple.com,notify.windows.com
# Structured operational monitoring. Metrics are available at /api/health/metrics with this bearer token.
LOG_FORMAT=json
LOG_LEVEL=INFO
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Slack/Discord-compatible HTTPS webhook for deduplicated updater and worker failures.
ALERT_WEBHOOK_URL=
# TZ=Asia/Kolkata
# Browser origins allowed to call the API directly (comma-separated; * = any). On a public site set it to
# your address (https://news.example.com) so other websites can't spend your AI allowance from their pages
ALLOWED_ORIGINS=*
# Host header allow-list. Production Compose sets this from DOMAIN.
ALLOWED_HOSTS=*
# Protects /admin, reports moderation and operations API (X-Admin-Token; empty disables owner access)
ADMIN_TOKEN=
# Temporary migration escape hatch only. Leave false after creating named accounts.
ALLOW_LEGACY_ADMIN_TOKEN=false
# Optional Slack/Discord-compatible webhook for updater failures. Keep this URL secret.
ALERT_WEBHOOK_URL=
# Staging uses apps/docker-compose.staging.yml and a separate .env.staging file.
STAGING_DOMAIN=

# DAILY DIGEST EMAIL (pipeline/email_digest.py)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_EMAIL_TO=
# Send one digest after the first successful edition of each day in the hourly cloud updater.
EMAIL_DIGEST_ENABLED=false

# Video
MINIMAX_API_KEY=

# NGROK
# ngrok config add-authtoken {}
# ngrok http http://localhost:3000

ALIYUN_USER_ID=
ALIYUN_USER=
ALIYUN_PASSWORD=
