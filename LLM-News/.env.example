# FUNDAS
PUBLISHER_LIST=us.TheNewYorker,us.FoxNews,uk.TheGuardian,tw.TaipeiTimes,my.MalayMail,ca.CBCNews
FUNDUS_MAX_ARTICLES=50
FUNDUS_START_DATE=
FUNDUS_END_DATE=

# REDDIT
REDDIT_ID=
REDDIT_KEY=
SUBREDDIT_LIST=news,technology,science,worldnews,entertainment
REDDIT_MAX_POST=20
REDDIT_MAX_COMMENT=10

# TRUST SCORE
RAPID_API_KEY=

# OTHER
GOOGLE_API_KEY=
ELEVENLAB_API_KEY=

# LLM
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ALIBABA_LLM_KEY=
ALIBABA_LLM_KEY_KG=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Free key from build.nvidia.com (starts with nvapi-). NVIDIA allows it for development and testing only.
NVIDIA_API_KEY=
# Preferred provider for the news pipeline and the website (OPENROUTER, OPENAI, ALIBABA, GEMINI, PERPLEXITY, NVIDIA).
# The pipeline defaults to ALIBABA; the website uses the first provider with a key.
LLM_PUBLISHER=
# Pipeline model override (default: that provider's model below)
LLM_MODEL=
# Fact-check / coverage-comparison model (default: LLM_MODEL). A different model checks more strictly.
CHECK_MODEL=
# Per-provider model overrides (defaults in apps/app/core/providers.py), e.g. a free OpenRouter model:
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# GEMINI_MODEL=gemini-2.5-flash
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b   (with CHECK_MODEL=openai/gpt-oss-20b)
# Knowledge Graph chat (Alibaba DashScope application)
ALIBABA_KG_APP_ID=

# WEBSITE
# PostgreSQL stores reports, corrections, analytics, budgets and updater coordination in Docker.
# Generate a URL-safe random production password; never keep the development fallback publicly.
POSTGRES_DB=newssense
POSTGRES_USER=newssense
POSTGRES_PASSWORD=
# AI requests per visitor per minute; chat questions per visitor per day (so one visitor can't use up
# everyone's allowance); AI calls per day across everyone. 0 = no cap
AI_RATE_LIMIT=20
AI_VISITOR_DAILY_LIMIT=50
AI_DAILY_CALL_LIMIT=500
# Persistent daily allowance for news generation; also adjustable in /admin. 0 disables the cap.
# Counts attempted calls, including failures; the updater and backend share apps/cache in Docker.
PIPELINE_DAILY_CALL_LIMIT=200
# A second hard stop across the calendar month. 0 disables the cap.
PIPELINE_MONTHLY_CALL_LIMIT=4000
# Shown on the About and Privacy pages for corrections and privacy questions
CONTACT_EMAIL=
# Public business/contact address shown in legal records when configured.
CONTACT_ADDRESS=
# Public address used in share previews, RSS and emails, e.g. https://news.example.com
PUBLIC_BASE_URL=
# Your domain, for HTTPS with apps/docker-compose.prod.yml (it sets PUBLIC_BASE_URL=https://DOMAIN)
DOMAIN=
# News updates in Docker (the "updater" service): minutes between updates, and the time zone that
# decides when a new day's edition starts (default UTC)
UPDATE_MINUTES=60
# Host directory containing generated editions and media. Deployment scripts default to separate
# /opt/newssense/data/production/static and /opt/newssense/data/staging/static directories.
# NEWS_DATA_DIR=/opt/newssense/data/production/static
# The readiness endpoint becomes unhealthy after this many minutes without a successful update.
# Keep it at least twice UPDATE_MINUTES to tolerate one delayed run.
STALE_AFTER_MINUTES=120
# A crashed updater's generation lease expires after this many seconds. This prevents overlapping AI spend.
UPDATE_LOCK_SECONDS=7200
# TZ=Asia/Kolkata
# Browser origins allowed to call the API directly (comma-separated; * = any). On a public site set it to
# your address (https://news.example.com) so other websites can't spend your AI allowance from their pages
ALLOWED_ORIGINS=*
# Host header allow-list. Production Compose sets this from DOMAIN.
ALLOWED_HOSTS=*
# Protects /admin, reports moderation and operations API (X-Admin-Token; empty disables owner access)
ADMIN_TOKEN=
# Optional Slack/Discord-compatible webhook for updater failures. Keep this URL secret.
ALERT_WEBHOOK_URL=
# Staging uses apps/docker-compose.staging.yml and a separate .env.staging file.
STAGING_DOMAIN=

# DAILY DIGEST EMAIL (pipeline/email_digest.py)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_EMAIL_TO=

# Video
MINIMAX_API_KEY=

# NGROK
# ngrok config add-authtoken {}
# ngrok http http://localhost:3000

ALIYUN_USER_ID=
ALIYUN_USER=
ALIYUN_PASSWORD=
