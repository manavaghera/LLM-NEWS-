# FUNDAS
PUBLISHER_LIST=us.TheNewYorker,us.FoxNews,uk.TheGuardian,tw.TaipeiTimes,my.MalayMail,ca.CBCNews
FUNDUS_MAX_ARTICLES=50
FUNDUS_START_DATE=
FUNDUS_END_DATE=

# REDDIT
REDDIT_ID=
REDDIT_KEY=
SUBREDDIT_LIST=news,technology,science,worldnews,entertainment
REDDIT_MAX_POST=20
REDDIT_MAX_COMMENT=10

# TRUST SCORE
RAPID_API_KEY=

# OTHER
GOOGLE_API_KEY=
ELEVENLAB_API_KEY=

# LLM
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ALIBABA_LLM_KEY=
ALIBABA_LLM_KEY_KG=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Preferred provider for the news pipeline and the website (OPENROUTER, OPENAI, ALIBABA, GEMINI, PERPLEXITY).
# The pipeline defaults to ALIBABA; the website uses the first provider with a key.
LLM_PUBLISHER=
# Pipeline model override (default: that provider's model below)
LLM_MODEL=
# Per-provider model overrides (defaults in apps/app/core/providers.py), e.g. a free OpenRouter model:
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# GEMINI_MODEL=gemini-2.5-flash
# Knowledge Graph chat (Alibaba DashScope application)
ALIBABA_KG_APP_ID=

# WEBSITE
# AI requests per visitor per minute, and AI calls per day across everyone (0 = no cap)
AI_RATE_LIMIT=20
AI_DAILY_CALL_LIMIT=500
# Public address used in share previews, RSS and emails, e.g. https://news.example.com
PUBLIC_BASE_URL=
# Browser origins allowed to call the API directly (comma-separated; * = any)
ALLOWED_ORIGINS=*

# DAILY DIGEST EMAIL (pipeline/email_digest.py)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_EMAIL_TO=

# Video
MINIMAX_API_KEY=

# NGROK
# ngrok config add-authtoken {}
# ngrok http http://localhost:3000

ALIYUN_USER_ID=
ALIYUN_USER=
ALIYUN_PASSWORD=
